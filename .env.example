# Copy this file to .env and fill in what you need. Never commit .env.

# --- API keys: only the providers you actually use need a key ---------------------------------
# By default every agent runs on Claude, so ANTHROPIC_API_KEY alone is enough for live mode.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Which provider and model each agent uses (optional; defaults shown) ----------------------
# PLANNER_PROVIDER=claude
# PLANNER_MODEL=claude-opus-5-5
# EXECUTOR_PROVIDER=claude
# EXECUTOR_MODEL=claude-sonnet-5-5
# REVIEWER_PROVIDER=claude
# REVIEWER_MODEL=claude-haiku-5-5
#
# Original three-vendor setup (needs all three keys):
# PLANNER_PROVIDER=openai
# EXECUTOR_PROVIDER=gemini
# REVIEWER_PROVIDER=claude

# Default models when a role is switched to OpenAI or Gemini without a <ROLE>_MODEL
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash

# --- Claude options (optional) ----------------------------------------------------------------
# CLAUDE_EFFORT=low          # low | medium | high | xhigh | max; empty = each model's default
# CLAUDE_FALLBACK=1          # 1 = a refusal on Opus/Sonnet is retried on a fallback model

DB_PATH=coordination.db
